rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && (request.auth.token.role == "admin" || request.auth.token.role == "super_admin"); }
    function validImage() { return request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    // Job evidence: jobs/{bookingId}/{before|after}/{file}
    match /jobs/{bookingId}/{phase}/{file} {
      allow read: if isAdmin() || (request.auth != null && (bookingId in request.auth.token.bookingIds || request.auth.uid != null));
      allow write: if request.auth != null && request.auth.token.role == "worker" && validImage();
    }
    match /profiles/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && validImage();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
