# Copy to apps/worker-pwa/.env.local and apps/admin-dashboard/.env.local
# Leave blank to run in DEMO MODE (local seed data, no Firebase needed)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_MAPS_API_KEY=
# Razorpay — source of truth for the whole project (gitignored .env).
# `node scripts/sync-razorpay-env.mjs` (also runs on functions predeploy) copies
# these into functions/.env. Never use VITE_/REACT_APP_/NEXT_PUBLIC_ for KEY_SECRET.
# KEY_ID is returned to Flutter by createPaymentOrder — secret stays server-side.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
