{
  "name": "@washpro/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "ZYLO Playwright end-to-end suite",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:customer": "playwright test --project=chromium tests/customer tests/authentication",
    "test:e2e:worker": "playwright test --project=worker-demo tests/worker",
    "test:e2e:admin": "playwright test --project=admin-demo tests/admin",
    "test:e2e:api": "playwright test --project=api tests/api",
    "test:e2e:payments": "playwright test --project=chromium tests/payments",
    "test:e2e:integration": "playwright test --project=chromium --project=admin-demo --project=worker-demo tests/integration",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:security": "playwright test --project=chromium tests/security",
    "test:e2e:report": "playwright show-report reports/html",
    "install:browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "dotenv": "^16.4.7"
  }
}
