# Copy to .env.test (never commit secrets).
# Default targets use Firebase Hosting + local demo worker/admin.

E2E_MARKETING_URL=https://wash-pro-7f3b1.web.app
E2E_CUSTOMER_WEB_URL=https://wash-pro-customer.web.app
E2E_WORKER_URL=http://127.0.0.1:5174
E2E_ADMIN_URL=http://127.0.0.1:5173

# Set to 0 to skip starting local Vite demo servers
E2E_LOCAL_DEMO=1
# Force fresh Vite processes with cleared VITE_FIREBASE_* (recommended for CI/agents)
E2E_FORCE_DEMO=1

# Optional — live Firebase logins (dedicated test accounts only)
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_WORKER_EMAIL=
# E2E_WORKER_PASSWORD=

# Optional — Firebase Console Phone Auth test number (never production SMS)
# E2E_TEST_PHONE=+919876543210
# E2E_TEST_OTP=123456

# Production smoke URLs (optional)
# E2E_PROD_MARKETING_URL=https://www.zyloo.co.in
# E2E_PROD_WORKER_URL=https://www.field.zyloo.co.in
